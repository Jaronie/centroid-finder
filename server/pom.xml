<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot projects inherit from spring-boot-starter-parent. That parent
    pins compatible versions for every Spring dependency, which is why the
    <dependencies> below carry no <version> tags.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/> <!-- empty: look the parent up in the repository, not on disk -->
  </parent>

  <groupId>io.github.jaronie</groupId>
  <artifactId>centroidServer</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>centroidServer</name>
  <description>HTTP API over the centroidFinder video processor</description>

  <properties>
    <!-- Matches the processor module. Spring Boot 4 needs 17 or later. -->
    <java.version>21</java.version>

    <!--
      JUnit tag selection, surfaced as properties so CI can pick a slice
      without a second pom or a profile.

      Tests tagged "integration" need something that is not in the repository:
      the processor jar (gitignored build output, ~100 MB) or ffmpeg. They skip
      themselves when it is missing, but skipping silently is not the same as
      choosing, so the CI "unit" job excludes them outright and the
      "integration" job supplies the prerequisites and runs everything.

        mvn test                                    # everything available
        mvn test -Dtest.excludedGroups=integration  # fast, hermetic subset
        mvn test -Dtest.groups=integration          # only the slow ones
    -->
    <test.groups></test.groups>
    <test.excludedGroups></test.excludedGroups>
  </properties>

  <dependencies>
    <!--
      Spring MVC + an embedded Tomcat. This is the only runtime dependency the
      server needs.

      NOTE: tutorials will tell you to use spring-boot-starter-web. As of
      Spring Boot 4 that artifact is deprecated in favour of this one. The old
      name still resolves and still works, but prefer -webmvc in new code.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!--
      DELIBERATELY ABSENT: io.github.jaronie:centroidFinder.

      The assignment forbids the server containing graph-search logic. Because
      both sides are Java we *could* add the processor as a dependency and call
      VideoPipeline directly, which is exactly what must not happen. The server
      reaches the processor only by launching centroidFinder.jar as a separate
      OS process via ProcessBuilder. Leaving this dependency out is what makes
      the rule impossible to break by accident: the processor's classes simply
      are not on the classpath.
    -->

    <!-- Test scope only: JUnit 5, AssertJ, Mockito, and Spring's test support. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Needed for @WebMvcTest / MockMvc, which moved to its own module in Boot 4. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Adds `mvn spring-boot:run` and makes `mvn package` produce an
        executable fat jar at target/centroidServer-1.0-SNAPSHOT.jar.
        Version comes from the parent.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Version comes from spring-boot-starter-parent; only the tag selection
        is ours. Both properties are empty by default, which surefire treats as
        "no filter", so a plain `mvn test` behaves exactly as before.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${test.groups}</groups>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
